{
  "name": "@software-factory/console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bunx --no-install tsc -p . --noEmit && vite build",
    "typecheck": "bunx --no-install tsc -p tsconfig.json --noEmit",
    "tokens": "basalt-ui tokens:css --selector-attribute data-theme --only core --out src/styles/tokens.css",
    "tokens:check": "basalt-ui tokens:css --selector-attribute data-theme --only core --out src/styles/tokens.css --check",
    "templates": "bun scripts/templates.ts",
    "templates:check": "bun scripts/templates.ts --check",
    "test": "bun test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@software-factory/contract": "workspace:*",
    "@tanstack/query-sync-storage-persister": "5.105.3",
    "@tanstack/react-hotkeys": "0.22.0",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-query-persist-client": "5.105.3",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-virtual": "3.14.26",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/router-plugin": "1.168.48",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "basalt-ui": "2.29.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "workbox-window": "7.4.1"
  }
}
