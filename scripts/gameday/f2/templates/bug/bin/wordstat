#!/usr/bin/env bash
# wordstat: count the words and lines on stdin.
# Usage: wordstat [--longest]      the longest word is added to the line
#        wordstat --self-test      run a fixed sample through this copy with its own config
set -euo pipefail

home=$(cd "$(dirname "$0")/.." && pwd)
conf=${WORDSTAT_CONF:-$home/config/limits.conf}
[[ -r $conf ]] || { echo "wordstat: no readable config (config/limits.conf)" >&2; exit 2; }
MAX_WORDS=""
# shellcheck disable=SC1090
source "$conf"
[[ $MAX_WORDS =~ ^[0-9]+$ ]] || { echo "wordstat: MAX_WORDS in config/limits.conf is not a number" >&2; exit 2; }

count() {
  local tmp words lines
  tmp=$(mktemp)
  cat >"$tmp"
  words=$(wc -w <"$tmp" | tr -d ' ')
  lines=$(wc -l <"$tmp" | tr -d ' ')
  rm -f "$tmp"
  if ((words > MAX_WORDS)); then
    echo "wordstat: $words words exceed MAX_WORDS=$MAX_WORDS (config/limits.conf)" >&2
    return 1
  fi
  echo "words=$words lines=$lines"
}

if [[ ${1:-} == --self-test ]]; then
  out=$(printf 'the quick brown fox\njumps over the lazy dog\n' | count) || { echo "selftest: FAIL"; exit 1; }
  [[ $out == "words=9 lines=2" ]] || { echo "selftest: FAIL got '$out'"; exit 1; }
  echo "selftest: ok $out"
  exit 0
fi
count
