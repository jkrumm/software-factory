# <path> <rule or *>  # <reason>. One line per file and rule the scan must let through; a stale line fails it.
apps/door/test/door.test.ts secret  # a made-up bearer proving the door refuses a token that is not its own
apps/server/test/checkpoints/domain.test.ts ipv4  # a private address the owner's-line redaction must turn into [host]
scripts/public-scan.ts *  # the rules themselves name what they forbid
scripts/test/public-scan.test.ts *  # the fixtures that prove each rule is caught
apps/server/src/adapters/reviews/pr.ts work-repo  # the review poll must recognise a merge-request host by its remote URL
apps/server/test/checkpoints/domain.test.ts host  # fixtures: a command addressed to the mini is the shape an approval Errand is read from
apps/server/test/checkpoints/need.test.ts host  # fixtures: the seven-day replay of command Errands, which are addressed to the mini
apps/server/test/loops/desk.test.ts host  # fixtures: an approval Errand's command is addressed to the mini
apps/server/test/checkpoints/checkpoints.test.ts host  # fixtures: commands addressed to the mini and a server, the shapes the host's-own-work rule refuses
apps/server/test/checkpoints/triage.test.ts host  # fixtures: commands addressed to the mini and a server, the shapes the host's-own-work rule refuses
apps/server/src/adapters/hygiene/probes/agentsmd.ts host  # names the local agent file the repo contract forbids: a file name, not a host
packages/contract/src/hygiene-catalogue.ts host  # the agentsmd entry names that file: a file name, not a host
docs/hygiene.md host  # generated from the catalogue: a file name, not a host
apps/server/test/hygiene/ci.test.ts work-repo  # fixture: a merge-request forge remote on example.com, proving the runner rule skips an origin that is not GitHub
packages/accounts/test/accounts.test.ts host  # fixtures: the commands the owner's peer adapters send to the peer
packages/accounts/test/owner-host.ts host  # fixture: the owner's host block (the ssh aliases of his two machines) that the parity and CLI tests run with
