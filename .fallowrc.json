{
  // Entry points the package.json files do not name: servers, scripts run by the Makefile or by hand, files a page loads.
  "entry": [
    "apps/server/src/main.ts",
    "apps/server/src/migrate-check.ts",
    "apps/server/scripts/*.ts",
    "apps/cli/scripts/*.ts",
    "apps/door/src/main.ts",
    "scripts/*.ts",
    "packages/accounts/scripts/*.ts",
    "apps/console/public/frame/*.js",
    "integrations/herdr/jk-glance/main.js",
    "docs/guide/.vitepress/config.ts",
    "docs/guide/.vitepress/theme/index.ts"
  ],
  // Provided by the host that loads the file, or by a package this repo already depends on: gpui-kit, gpui-base and herdr
  // by the Herdr app that runs integrations/herdr/jk-glance.
  "ignoreDependencies": ["gpui-kit", "gpui-base", "herdr"],
  "rules": {
    // Domain modules name their own words (Breach, Checked, Entry ...); two modules exporting the same name is not dead code.
    "duplicate-exports": "off"
  }
}
