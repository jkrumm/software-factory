{
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "trailingComma": "all",
  "semi": false,
  "arrowParens": "always",
  "bracketSpacing": true,
  "sortPackageJson": false,
  "ignorePatterns": ["**/*.md", "docs/**", ".claude/**", "bun.lock", "deploy/**", "node_modules/**"]
}
