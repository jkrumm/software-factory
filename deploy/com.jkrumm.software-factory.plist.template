<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jkrumm.software-factory</string>

  <!-- Never a Homebrew binary directly (macOS BTM disallows it): the wrapper script is the indirection. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__RELEASE_DIR__/scripts/launch.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__RELEASE_DIR__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PORT</key>
    <string>7793</string>
    <!-- herdr-core's hc: found by its absolute path; HOME above is how it finds the core's socket. -->
    <key>HC_BIN</key>
    <string>__HOME__/.local/bin/hc</string>
    <key>FACTORY_VERSION</key>
    <string>__SHA__</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- A fail-closed launch (exit 78) retries at this pace, not in a tight loop. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <!-- launchd sends SIGTERM, then SIGKILL after ExitTimeOut. The new core ends itself within its own 30 s shutdown deadline
       (apps/server/src/shutdown.ts, FACTORY_SHUTDOWN_DEADLINE_MS): draining aborts a lead start in flight instead of waiting for
       it, the steps run in order, and the deadline exits 1 wherever the stop is stuck. The old core's 180 s start budget and 210 s
       backstop do not apply to it. 240 s stays as the outer bound, for a process that outlives its own deadline (a bug): the
       runbook then reads the PID before the stop and kills that PID, never a pattern. A rollback onto the old core still needs it. -->
  <key>ExitTimeOut</key>
  <integer>240</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/software-factory.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/software-factory.err.log</string>
</dict>
</plist>
